<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caption Settings"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Display"
        android:textColor="#4FC3F7"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Switch
        android:id="@+id/switchShowOriginal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show original English caption"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Switch
        android:id="@+id/switchShowChinese"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Chinese translation"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Switch
        android:id="@+id/switchShowPinyin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Pinyin"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Switch
        android:id="@+id/switchShowJyutping"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show Jyutping"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Translation"
        android:textColor="#4FC3F7"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Switch
        android:id="@+id/switchTranslationEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Translate captions (turn off to show original + romanization only)"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caption region (fraction of screen, 0.0-1.0)"
        android:textColor="#4FC3F7"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adjust these if YouTube's captions aren't in the default bottom-center area."
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top"
                android:textColor="#AAAAAA" />
            <EditText
                android:id="@+id/fieldCropTop"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bottom"
                android:textColor="#AAAAAA" />
            <EditText
                android:id="@+id/fieldCropBottom"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Left"
                android:textColor="#AAAAAA" />
            <EditText
                android:id="@+id/fieldCropLeft"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Right"
                android:textColor="#AAAAAA" />
            <EditText
                android:id="@+id/fieldCropRight"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">
        <Button
            android:id="@+id/buttonSaveCrop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save region"
            android:layout_marginEnd="16dp" />
        <Button
            android:id="@+id/buttonResetCrop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset to default" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Debug"
        android:textColor="#4FC3F7"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <Switch
        android:id="@+id/switchDebugLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log recognized captions to ocr_log.txt"
        android:textColor="#FFFFFF" />

</LinearLayout>
</ScrollView>
